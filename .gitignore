# Claude Code internal directory (worktrees, plans, launch config)
.claude/
# RStudio
.Rproj.user
.Rhistory
.RData
.Ruserdata
# macOS
.DS_Store
# Quarto system dir (contains temporary state)
.quarto/
#pdf directory
.pdf/
# Quarto/knitr caches
.qmd-cache/
*_cache/
_freeze/
# LaTeX build junk
*.log
*.aux
*.out
# Ignore root-level _files folders (from rendering individual chapters)
*_files/
# Knitr intermediate markdown (produced by rendering a single .qmd directly)
*.knit.md
# Keep published site outputs in docs/
!docs/**
/.quarto/
_freeze/
**/*.quarto_ipynb
gganim_*
